# CIRISRegistry API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (reuse existing CIRIS credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Key Encryption (for custody model)
# Generate with: openssl rand -base64 32
KEY_ENCRYPTION_KEY=your-encryption-key-for-custodied-keys

# Optional: Database for session storage
# DATABASE_URL=postgresql://user:password@localhost:5432/portal
