# ===========================================
# CIRISPortal Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in values

# ===========================================
# Environment Mode
# ===========================================
# Options: devtest | stage | prod
# - devtest: Local dev with test user bypass (no OAuth required)
# - stage: Staging (OAuth required, relaxed domain checks)
# - prod: Production (OAuth required, strict domain validation)
APP_ENV=devtest
NEXT_PUBLIC_APP_ENV=devtest

# ===========================================
# API Configuration
# ===========================================

# Registry API base URL for client-side SDK
# Use relative path for local proxy, full URL for production
NEXT_PUBLIC_REGISTRY_API_URL=/api/registry

# gRPC backend URL (server-side only, not exposed to browser)
# Default: localhost:50052 for local development
REGISTRY_GRPC_URL=localhost:50052

# ===========================================
# NextAuth Configuration
# ===========================================

# Public URL of the application (must match OAuth redirect URIs)
NEXTAUTH_URL=http://localhost:3000

# Secret for JWT signing and encryption
# REQUIRED: Generate with: openssl rand -base64 32
# Must be at least 32 characters
NEXTAUTH_SECRET=

# ===========================================
# OAuth Providers
# ===========================================

# Google OAuth (required for stage/prod, optional for devtest)
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===========================================
# Security Configuration
# ===========================================

# Master Key Encryption Key for envelope encryption of custodied keys
# REQUIRED for key custody features
# Generate with: openssl rand -base64 32
# Must be exactly 32 bytes (256 bits) when decoded
KEY_ENCRYPTION_KEY=

# Allowed email domains for OAuth sign-in (comma-separated)
# Only enforced in prod mode. Empty = deny all non-test users
# Example: ciris.ai,trusted-partner.com
ALLOWED_EMAIL_DOMAINS=

# ===========================================
# Test Users (devtest mode only)
# ===========================================
# Pre-configured test users for local development:
#
# | Email                      | Password    | Role  | Org            |
# |---------------------------|-------------|-------|----------------|
# | admin@qa-primary.test     | testpass123 | Admin | Primary Org    |
# | user@qa-primary.test      | testpass123 | User  | Primary Org    |
# | admin@qa-secondary.test   | testpass123 | Admin | Secondary Org  |
#
# These users are only available when APP_ENV=devtest
# DO NOT use these credentials in production

# ===========================================
# Cloudflare Workers (Production)
# ===========================================
# These are set via wrangler secrets, not .env files:
#
# wrangler secret put NEXTAUTH_SECRET
# wrangler secret put GOOGLE_CLIENT_ID
# wrangler secret put GOOGLE_CLIENT_SECRET
# wrangler secret put KEY_ENCRYPTION_KEY
