# ===========================================
# CIRISPortal Environment Configuration
# ===========================================

# Environment Mode: devtest | stage | prod
# - devtest: Local dev with test user bypass (no OAuth required)
# - stage: Staging (OAuth required, relaxed domain checks)
# - prod: Production (OAuth required, strict domain validation)
APP_ENV=devtest
NEXT_PUBLIC_APP_ENV=devtest

# ===========================================
# API Configuration
# ===========================================

# Registry API URL (use /api/registry for local proxy)
NEXT_PUBLIC_REGISTRY_API_URL=/api/registry

# gRPC backend URL (used by API routes server-side)
REGISTRY_GRPC_URL=localhost:50052

# ===========================================
# NextAuth Configuration
# ===========================================

# Public URL of the application
NEXTAUTH_URL=http://localhost:3000

# Secret for JWT signing (min 32 characters, generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-secret-key-here-min-32-characters

# ===========================================
# OAuth Providers
# ===========================================

# Google OAuth (required for stage/prod, optional for devtest)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===========================================
# Security
# ===========================================

# Key encryption key for custody model (generate with: openssl rand -base64 32)
KEY_ENCRYPTION_KEY=your-encryption-key-here

# Allowed email domains (comma-separated, prod only)
# ALLOWED_EMAIL_DOMAINS=example.com,company.org

# ===========================================
# Test Users (devtest mode only)
# ===========================================
# Pre-configured test users:
# - admin@qa-primary.test / testpass123 (Admin, Primary Org)
# - user@qa-primary.test / testpass123 (User, Primary Org)
# - admin@qa-secondary.test / testpass123 (Admin, Secondary Org)
