# ===========================================
# CIRISPortal Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in values

# ===========================================
# Environment Mode
# ===========================================
# Options: devtest | stage | prod
# - devtest: Local dev with test user bypass (no OAuth required)
# - stage: Staging (OAuth required, relaxed domain checks)
# - prod: Production (OAuth required, strict domain validation)
APP_ENV=devtest
NEXT_PUBLIC_APP_ENV=devtest

# ===========================================
# API Configuration
# ===========================================

# Registry API base URL for client-side SDK
# Use relative path for local proxy, full URL for production
NEXT_PUBLIC_REGISTRY_API_URL=/api/registry

# gRPC backend URL (server-side only, not exposed to browser)
# Default: localhost:50052 for local development
REGISTRY_GRPC_URL=localhost:50052

# ===========================================
# NextAuth Configuration
# ===========================================

# Public URL of the application (must match OAuth redirect URIs)
NEXTAUTH_URL=http://localhost:3000

# Secret for JWT signing and encryption
# REQUIRED: Generate with: openssl rand -base64 32
# Must be at least 32 characters
NEXTAUTH_SECRET=

# ===========================================
# OAuth Providers
# ===========================================

# Google OAuth (required for stage/prod, optional for devtest)
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth (optional — Sign in with Apple)
# Setup: https://developer.apple.com/account/resources/
# 1. Register App ID with Sign in with Apple capability
# 2. Register Services ID (→ APPLE_CLIENT_ID)
# 3. Create private key (→ .p8 file, APPLE_KEY_ID)
# 4. Return URL: https://portal.ciris.ai/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ===========================================
# Security Configuration
# ===========================================

# Master Key Encryption Key for envelope encryption of custodied keys
# REQUIRED for key custody features
# Generate with: openssl rand -base64 32
# Must be exactly 32 bytes (256 bits) when decoded
KEY_ENCRYPTION_KEY=

# Allowed email domains for OAuth sign-in (comma-separated)
# Only enforced in prod mode. Empty = deny all non-test users
# Example: ciris.ai,trusted-partner.com
ALLOWED_EMAIL_DOMAINS=

# ===========================================
# Test Users (devtest mode only)
# ===========================================
# Pre-configured test users for local development:
#
# | Email                      | Password    | Role  | Org            |
# |---------------------------|-------------|-------|----------------|
# | admin@qa-primary.test     | testpass123 | Admin | Primary Org    |
# | user@qa-primary.test      | testpass123 | User  | Primary Org    |
# | admin@qa-secondary.test   | testpass123 | Admin | Secondary Org  |
#
# These users are only available when APP_ENV=devtest
# DO NOT use these credentials in production

# ===========================================
# Stripe Billing (optional — not needed for devtest)
# ===========================================

# Stripe secret key (sk_test_... or sk_live_...)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (whsec_...)
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=

# --- Activation Products (one-time) ---
# Create these in Stripe Dashboard as one-time prices
# Test-mode price IDs shown in comments for reference

# Community tier — CIRIS agents ($0.50 issuance + $1.00 bond)
STRIPE_PRICE_ISSUANCE_COMMUNITY=        # test: price_1T21eqD6B7ILDjd5C8iHI7pw
STRIPE_PRICE_BOND_COMMUNITY=            # test: price_1T21kwD6B7ILDjd5XptA9cog

# Community tier — Non-CIRIS agents (same pricing, separate tracking)
STRIPE_PRICE_ISSUANCE_NONCIRIS_COMMUNITY=  # test: price_1T21jCD6B7ILDjd5WqNivC5x
STRIPE_PRICE_BOND_NONCIRIS_COMMUNITY=      # test: price_1T222sD6B7ILDjd5npLTxLfT

# Professional tier activation ($5.00 issuance + $10.00 bond)
STRIPE_PRICE_ISSUANCE_PRO=              # test: price_1T21pYD6B7ILDjd5epdFRNiA
STRIPE_PRICE_BOND_PRO=                  # test: price_1T225LD6B7ILDjd5aosiB7G5

# Enterprise tier activation ($25.00 issuance + $100.00 bond)
STRIPE_PRICE_ISSUANCE_ENTERPRISE=       # test: price_1T226tD6B7ILDjd5TvqpGGxy
STRIPE_PRICE_BOND_ENTERPRISE=           # test: price_1T228OD6B7ILDjd58XMMLu63

# --- Subscription Products (recurring assurance) ---
# Create these in Stripe Dashboard as recurring monthly prices

# Professional assurance ($10/mo per agent)
STRIPE_PRICE_ID_PRO=                    # test: price_1T229WD6B7ILDjd5zbseJIvj

# Enterprise assurance ($100/mo per agent)
STRIPE_PRICE_ID_ENTERPRISE=             # test: price_1T21tOD6B7ILDjd5Dv21MlWQ

# Safety-Critical product (custom pricing per customer)
STRIPE_PRODUCT_ID_SAFETY=

# ===========================================
# Registry JWT (server-to-server auth)
# ===========================================

# Shared secret for Portal → Registry gRPC JWT auth
# Generate with: openssl rand -hex 32
REGISTRY_JWT_SECRET=

# JWT issuer claim (default: ciris-registry)
REGISTRY_JWT_ISSUER=ciris-registry

# ===========================================
# Cloudflare Workers (Production)
# ===========================================
# These are set via wrangler secrets, not .env files:
#
# wrangler secret put NEXTAUTH_SECRET
# wrangler secret put GOOGLE_CLIENT_ID
# wrangler secret put GOOGLE_CLIENT_SECRET
# wrangler secret put APPLE_CLIENT_ID
# wrangler secret put APPLE_TEAM_ID
# wrangler secret put APPLE_KEY_ID
# wrangler secret put APPLE_PRIVATE_KEY
# wrangler secret put KEY_ENCRYPTION_KEY
# wrangler secret put STRIPE_SECRET_KEY
# wrangler secret put STRIPE_WEBHOOK_SECRET
